# ==============================================================================
# Devasthaly Vidyapeeth — Backend Admin Environment Configuration
# ==============================================================================

# Server Configuration (Loopback preview)
PORT=3001
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# Public Media Origin
# Base origin used to construct client-facing URLs for managed media assets (e.g. topper photos).
# In local development: http://127.0.0.1:3001
# In production: https://admin.devasthaly.edu.in
PUBLIC_MEDIA_ORIGIN=http://127.0.0.1:3001

# Local Storage Production Guard (Default: disabled)
# Local filesystem storage is strictly prohibited in production environments unless explicitly authorized.
# ALLOW_LOCAL_STORAGE_IN_PRODUCTION=false

# ------------------------------------------------------------------------------
# PostgreSQL Database (Prisma ORM)
# ------------------------------------------------------------------------------
# Standard connection URL for local PostgreSQL instance:
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/dvp?schema=public"

# Optional: Direct connection URL (only needed if using a PgBouncer / Supabase connection pooler):
# DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/dvp?schema=public"

# ------------------------------------------------------------------------------
# Administrator Authentication & Session Security (Production Blockers)
# ------------------------------------------------------------------------------
# Secret key used to sign and verify administrative session tokens / JWTs
AUTH_SECRET="change-me-to-a-secure-random-32-byte-hex-string"

# Session expiration time in seconds (default: 86400 = 24 hours)
SESSION_MAX_AGE=86400
