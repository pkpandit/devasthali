// Prisma Schema for Devasthaly Vidyapeeth — Administration & Identity
// Target: PostgreSQL
// Phase 1: Authentication & Audit Foundation
// Reference for full content & operational models: ./recovered-schema.prisma

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. ENUMS (ADMINISTRATIVE ROLES)
// ==========================================

enum Role {
  SUPER_ADMIN        // Trust management, full system access
  PRINCIPAL          // Academic director, approval authority, notices
  ADMISSIONS_OFFICER // Admissions desk, lead status tracking, fee verification
  TEACHER            // Class notices, homework, exam marks entry
  STAFF              // Office clerk, document/TC issuance
}

// ==========================================
// 2. CORE IDENTITY & AUTHENTICATION MODELS
// ==========================================

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String
  image         String?
  role          Role      @default(STAFF)
  isActive      Boolean   @default(true)
  phoneNumber   String?
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  auditLogs     AuditLog[]

  @@index([role, isActive])
  @@map("users")
}

model Session {
  id               String   @id @default(cuid())
  sessionTokenHash String   @unique
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  ipAddress        String?
  userAgent        String?

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ==========================================
// 3. AUDIT TRAILS (AUTH & SECURITY EVENTS)
// ==========================================

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String   // E.g., 'AUTH_LOGIN_SUCCESS', 'AUTH_LOGIN_FAILED', 'AUTH_LOGOUT', 'AUTH_PASSWORD_CHANGE', 'AUTH_STATUS_CHANGE'
  entityType String   // Target entity type: 'User', 'Session'
  entityId   String   // Target entity ID
  metadata   Json?    // Structured diagnostic context (IP, user agent, failure reason, modified fields)
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ==========================================
// 4. ACADEMIC RESULTS & TOPPERS
// ==========================================

model BoardResultTopper {
  id              String   @id @default(cuid())
  studentName     String
  scorePercent    Decimal  @db.Decimal(5, 2)
  grade           String   // "Class X" | "Class XII"
  stream          String?  // Optional: "Science (PCM)", "Commerce", "Humanities"
  academicYear    String   // e.g. "2024-25"
  achievement     String   // e.g. "School Topper - 98.4%"
  photoUrl        String?
  photoStorageKey String?
  displayOrder    Int      @default(0)
  isFeatured      Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([academicYear, grade])
  @@index([isFeatured, displayOrder])
  @@map("board_result_toppers")
}
