// Prisma Schema for Devasthaly Vidyapeeth — Administration & Identity
// Target: PostgreSQL
// Phase 1: Authentication & Audit Foundation
// Reference for full content & operational models: ./recovered-schema.prisma

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. ENUMS (ADMINISTRATIVE ROLES)
// ==========================================

enum Role {
  SUPER_ADMIN        // Trust management, full system access
  PRINCIPAL          // Academic director, approval authority, notices
  ADMISSIONS_OFFICER // Admissions desk, lead status tracking, fee verification
  TEACHER            // Class notices, homework, exam marks entry
  STAFF              // Office clerk, document/TC issuance
}

// ==========================================
// 2. CORE IDENTITY & AUTHENTICATION MODELS
// ==========================================

model User {
  id              String     @id @default(cuid())
  name            String
  email           String     @unique
  emailVerified   DateTime?
  passwordHash    String
  image           String?
  role            Role       @default(STAFF)
  isActive        Boolean    @default(true)
  phoneNumber     String?
  lastLoginAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  sessions        Session[]
  auditLogs       AuditLog[]
  noticesAuthored Notice[]   @relation("NoticesAuthored")

  @@index([role, isActive])
  @@map("users")
}

model Session {
  id               String   @id @default(cuid())
  sessionTokenHash String   @unique
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  ipAddress        String?
  userAgent        String?

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ==========================================
// 3. AUDIT TRAILS (AUTH & SECURITY EVENTS)
// ==========================================

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String   // E.g., 'AUTH_LOGIN_SUCCESS', 'AUTH_LOGIN_FAILED', 'NOTICE_CREATED', 'SITE_PROFILE_UPDATED', etc.
  entityType String   // Target entity type: 'User', 'Session', 'BoardResultTopper', 'Notice', 'SiteProfile', 'CampusDirectoryEntry', 'NavigationItem', 'NavigationColumn', 'NavigationLinkItem', 'HomepageHero', 'HomepagePrincipalMessage', 'HomepageStatistic', 'HomepageHighlight', 'DownloadCategory', 'DownloadDocument', 'DisclosureSection', 'DisclosureDocument'
  entityId   String   // Target entity ID
  metadata   Json?    // Structured diagnostic context (IP, user agent, failure reason, modified fields)
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ==========================================
// 4. ACADEMIC RESULTS & TOPPERS
// ==========================================

model BoardResultTopper {
  id              String   @id @default(cuid())
  studentName     String
  scorePercent    Decimal  @db.Decimal(5, 2)
  grade           String   // "Class X" | "Class XII"
  stream          String?  // Optional: "Science (PCM)", "Commerce", "Humanities"
  academicYear    String   // e.g. "2024-25"
  achievement     String   // e.g. "School Topper - 98.4%"
  photoUrl        String?
  photoStorageKey String?
  photoAlt        String   @default("") @db.VarChar(255)
  displayOrder    Int      @default(0)
  isPublished     Boolean  @default(true)
  isFeatured      Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([academicYear, grade])
  @@index([isPublished, displayOrder])
  @@index([isPublished, academicYear])
  @@index([isFeatured, displayOrder])
  @@map("board_result_toppers")
}

// ==========================================
// 5. OFFICIAL NOTICES & CIRCULARS
// ==========================================

enum NoticeCategory {
  CIRCULAR             // Administrative, holiday, and operational circulars
  EXAMINATION          // Date sheets, entrance tests, hall tickets, results
  ADMISSION            // Admission announcements and prospectus notices
  EVENT                // School ceremonies, exhibitions, competitions
}

model Notice {
  id               String         @id @default(cuid())
  title            String
  slug             String         @unique
  category         NoticeCategory @default(CIRCULAR)
  summary          String?        @db.Text
  content          String?        @db.Text
  isUrgent         Boolean        @default(false)
  isPublished      Boolean        @default(false)
  fileUrl          String?        // Approved root-relative document path or HTTPS URL
  fileSize         String?        // Human-readable size indicator (e.g. "245 KB")
  publishDate      DateTime       @default(now())
  publishedAt      DateTime?      // Exact timestamp when marked published
  expiryDate       DateTime?      // Optional date after which notice is archived
  displayOrder     Int            @default(0)

  // Managed document attachment metadata (Phase 2)
  fileStorageKey   String?        @db.VarChar(255)
  fileSizeBytes    Int?
  fileSha256       String?        @db.VarChar(64)
  fileOriginalName String?        @db.VarChar(255)
  fileUploadedAt   DateTime?

  authorId         String?
  author           User?          @relation("NoticesAuthored", fields: [authorId], references: [id], onDelete: SetNull)
  attachments      NoticeAttachment[]

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([isPublished, publishDate])
  @@index([category, isPublished])
  @@index([displayOrder, publishDate])
  @@index([fileStorageKey])
  @@map("notices")
}

model NoticeAttachment {
  id             String   @id @default(cuid())
  noticeId       String
  notice         Notice   @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  title          String
  fileUrl        String?
  fileStorageKey String?  @db.VarChar(255)
  fileSizeBytes  Int?
  fileSize       String?
  fileType       String   @default("application/pdf")
  displayOrder   Int      @default(0)
  isPublished    Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([noticeId, displayOrder])
  @@index([noticeId, isPublished])
  @@index([fileStorageKey])
  @@map("notice_attachments")
}

// ==========================================
// 6. INSTITUTIONAL IDENTITY & SITE PROFILE
// ==========================================

model SiteProfile {
  id                String   @id @default("default") // Singleton identifier
  schoolName        String   @default("School Name")
  tagline           String?
  affiliationNo     String?
  schoolCode        String?
  establishedYear   Int?
  legacyYearsText   String?
  schoolType        String?
  medium            String?
  gradesOffered     String?

  // Physical Campus Address
  campusAddress     String?
  tehsil            String?
  district          String?
  state             String?
  pinCode           String?
  landmark          String?

  // Primary Helplines & Office Contacts
  primaryPhone      String?
  admissionsPhone   String?
  receptionPhone    String?
  hostelWardenPhone String?
  whatsappNumber    String?
  officeEmail       String?
  principalEmail    String?
  workingHours      String?

  // Social Channel Links
  facebookUrl       String?
  youtubeUrl        String?
  instagramUrl      String?

  // Campus Location, Directions & Map (Milestone 13)
  mapEmbedUrl            String?
  mapDirectionsUrl       String?
  directionsOverview     String?
  visitorGuidelines      String?

  // 24/7 Campus Emergency Desks (Milestone 13)
  emergencyMedicalPhone  String?
  emergencySecurityPhone String?

  // Footer & Compliance Meta
  copyrightText     String?

  updatedAt         DateTime @updatedAt

  @@map("site_profiles")
}

// ==========================================
// 7. CAMPUS DIRECTORY & HELPLINE CONTACTS
// ==========================================

enum DirectoryCategory {
  ADMINISTRATION
  HOSTEL_WARDEN
  ACADEMIC_COORDINATOR
  OFFICE_ACCOUNTS
  SECURITY_TRANSPORT
}

model CampusDirectoryEntry {
  id           String            @id @default(cuid())
  category     DirectoryCategory @default(ADMINISTRATION)
  roleTitle    String
  contactName  String?
  department   String?
  phoneNumber  String
  displayOrder Int               @default(0)
  isPublished  Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([category, isPublished, displayOrder])
  @@map("campus_directory_entries")
}

// ==========================================
// 8. SITE NAVIGATION & MEGA-MENU MODELS
// ==========================================

enum NavigationLocation {
  HEADER_PRIMARY
  FOOTER_ADMISSIONS
  FOOTER_COMMUNITY
}

enum NavigationPanelType {
  NONE
  COMPACT
  MEDIUM
  MEGA
}

model NavigationItem {
  id           String              @id @default(cuid())
  location     NavigationLocation  @default(HEADER_PRIMARY)
  label        String
  href         String
  panelType    NavigationPanelType @default(NONE)
  badge        String?
  displayOrder Int                 @default(0)
  isPublished  Boolean             @default(true)
  openInNewTab Boolean             @default(false)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  columns      NavigationColumn[]

  @@index([location, isPublished, displayOrder])
  @@map("navigation_items")
}

model NavigationColumn {
  id           String             @id @default(cuid())
  itemId       String
  heading      String?
  displayOrder Int                @default(0)
  isPublished  Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  item         NavigationItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  links        NavigationLinkItem[]

  @@index([itemId, isPublished, displayOrder])
  @@map("navigation_columns")
}

model NavigationLinkItem {
  id           String           @id @default(cuid())
  columnId     String
  label        String
  href         String
  badge        String?
  displayOrder Int              @default(0)
  isPublished  Boolean          @default(true)
  openInNewTab Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  column       NavigationColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)

  @@index([columnId, isPublished, displayOrder])
  @@map("navigation_link_items")
}

// ==========================================
// 9. HOMEPAGE CONTENT MANAGEMENT (MILESTONE 3)
// ==========================================

model HomepageHero {
  id                        String   @id @default("default") // Singleton identifier
  badgeText                 String?  @db.VarChar(120)
  heading                   String   @db.VarChar(255)
  highlightText             String?  @db.VarChar(100)
  subheading                String   @db.Text
  primaryCtaLabel           String   @db.VarChar(60)
  primaryCtaHref            String   @db.VarChar(500)
  secondaryCtaLabel         String?  @db.VarChar(60)
  secondaryCtaHref          String?  @db.VarChar(500)
  backgroundImageUrl        String?  @db.VarChar(500)
  backgroundImageStorageKey String?  @db.VarChar(255)
  isPublished               Boolean  @default(true)
  updatedAt                 DateTime @updatedAt

  @@map("homepage_hero")
}

model HomepagePrincipalMessage {
  id                   String   @id @default("default") // Singleton identifier
  heading              String   @db.VarChar(120)
  principalName        String   @db.VarChar(120)
  principalDesignation String   @db.VarChar(120)
  quote                String   @db.VarChar(500)
  excerpt              String   @db.Text
  imageUrl             String?  @db.VarChar(500)
  imageStorageKey      String?  @db.VarChar(255)
  ctaLabel             String?  @db.VarChar(60)
  ctaHref              String?  @db.VarChar(500)
  isPublished          Boolean  @default(true)
  updatedAt            DateTime @updatedAt

  @@map("homepage_principal_message")
}

model HomepageStatistic {
  id              String   @id @default(cuid())
  label           String   @db.VarChar(120)
  numericValue    String   @db.VarChar(40)
  suffix          String?  @db.VarChar(20)
  subtext         String?  @db.VarChar(120)
  badge           String?  @db.VarChar(40)
  iconName        String?  @db.VarChar(60)
  imageUrl        String?  @db.VarChar(500)
  imageStorageKey String?  @db.VarChar(255)
  displayOrder    Int      @default(0)
  isPublished     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isPublished, displayOrder])
  @@map("homepage_statistics")
}

model HomepageHighlight {
  id              String   @id @default(cuid())
  title           String   @db.VarChar(120)
  description     String   @db.VarChar(255)
  badge           String?  @db.VarChar(40)
  iconName        String?  @db.VarChar(60)
  imageUrl        String?  @db.VarChar(500)
  imageStorageKey String?  @db.VarChar(255)
  ctaLabel        String   @db.VarChar(60)
  ctaHref         String   @db.VarChar(500)
  displayOrder    Int      @default(0)
  isPublished     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isPublished, displayOrder])
  @@map("homepage_highlights")
}


// ==========================================
// 10. ABOUT SCHOOL & LEADERSHIP MODELS
// ==========================================

enum LeadershipRole {
  FOUNDER
  PATRON
  PRESIDENT
  MANAGER
  PRINCIPAL
}

model AboutPageSetting {
  id                      String   @id @default("default")
  breadcrumb              String   @default("") @db.VarChar(120)
  heading                 String   @default("") @db.VarChar(120)
  subheading              String   @default("") @db.VarChar(1000)
  showcaseImageUrl        String?  @db.VarChar(500)
  showcaseImageStorageKey String?  @db.VarChar(255)
  showcaseImageAlt        String?  @db.VarChar(255)
  showcaseBadge           String?  @db.VarChar(60)
  isPublished             Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@map("about_page_settings")
}

model AboutCredential {
  id           String   @id @default(cuid())
  category     String   @default("") @db.VarChar(60)
  title        String   @default("") @db.VarChar(120)
  subtext      String   @default("") @db.VarChar(120)
  iconName     String?  @db.VarChar(60)
  displayOrder Int      @default(0)
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isPublished, displayOrder])
  @@map("about_credentials")
}

model AboutNarrativeSection {
  id              String   @id @default(cuid())
  heading         String?  @db.VarChar(120)
  body            String   @db.Text
  imageUrl        String?  @db.VarChar(500)
  imageStorageKey String?  @db.VarChar(255)
  imageAlt        String?  @db.VarChar(255)
  displayOrder    Int      @default(0)
  isPublished     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isPublished, displayOrder])
  @@map("about_narrative_sections")
}

model VisionMissionSetting {
  id           String   @id @default("default")
  breadcrumb   String   @default("") @db.VarChar(120)
  heading      String   @default("") @db.VarChar(120)
  subheading   String   @default("") @db.VarChar(1000)
  visionTitle  String   @default("") @db.VarChar(120)
  visionBody   String   @default("") @db.Text
  visionIcon   String   @default("") @db.VarChar(60)
  missionTitle String   @default("") @db.VarChar(120)
  missionBody  String   @default("") @db.Text
  missionIcon  String   @default("") @db.VarChar(60)
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("vision_mission_settings")
}

model InstitutionalCoreValue {
  id           String   @id @default(cuid())
  title        String   @default("") @db.VarChar(120)
  description  String   @default("") @db.Text
  iconName     String?  @db.VarChar(60)
  displayOrder Int      @default(0)
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isPublished, displayOrder])
  @@map("institutional_core_values")
}

model LeadershipMember {
  id                  String         @id @default(cuid())
  role                LeadershipRole @unique
  slug                String         @unique @db.VarChar(100)
  pageTitle           String         @default("") @db.VarChar(120)
  breadcrumb          String         @default("") @db.VarChar(120)
  badgeText           String         @default("") @db.VarChar(60)
  name                String         @default("") @db.VarChar(120)
  designation         String         @default("") @db.VarChar(120)
  termOrAffiliation   String?        @db.VarChar(120)
  location            String?        @db.VarChar(200)
  shortIntro          String         @default("") @db.VarChar(1000)
  quote               String?        @db.Text
  messageBody         String         @default("") @db.Text
  imageUrl            String?        @db.VarChar(500)
  imageStorageKey     String?        @db.VarChar(255)
  imageAlt            String?        @db.VarChar(255)
  signatureImageUrl   String?        @db.VarChar(500)
  signatureStorageKey String?        @db.VarChar(255)
  signatureAlt        String?        @db.VarChar(255)
  bio                 String?        @db.Text
  ctaLabel            String?        @db.VarChar(60)
  ctaHref             String?        @db.VarChar(500)
  displayOrder        Int            @default(0)
  isPublished         Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([isPublished, displayOrder])
  @@index([slug])
  @@map("leadership_members")
}

// ==========================================
// 11. FACULTY & MENTORS DIRECTORY
// ==========================================

model FacultyMember {
  id              String   @id @default(cuid())
  name            String   @db.VarChar(120)
  designation     String   @db.VarChar(120)
  department      String   @db.VarChar(120)
  qualification   String?  @db.VarChar(255)
  experienceYears Int      @default(0)
  bio             String?  @db.Text
  imageUrl        String?  @db.VarChar(500)
  imageStorageKey String?  @db.VarChar(255)
  imageAlt        String   @default("") @db.VarChar(255)
  displayOrder    Int      @default(0)
  isPublished     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isPublished, displayOrder])
  @@index([department])
  @@map("faculty_members")
}


// ==========================================
// 12. CAMPUS GALLERY (ALBUMS & IMAGES)
// ==========================================

model GalleryAlbum {
  id                   String         @id @default(cuid())
  title                String         @db.VarChar(150)
  description          String?        @db.Text
  category             String         @db.VarChar(60)
  coverImageUrl        String         @db.VarChar(500)
  coverImageStorageKey String?        @db.VarChar(255)
  coverImageAlt        String         @default("") @db.VarChar(255)
  displayOrder         Int            @default(0)
  isPublished          Boolean        @default(true)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  images               GalleryImage[] @relation("AlbumImages")

  @@index([isPublished, displayOrder])
  @@index([category])
  @@map("gallery_albums")
}

model GalleryImage {
  id              String       @id @default(cuid())
  albumId         String
  album           GalleryAlbum @relation("AlbumImages", fields: [albumId], references: [id], onDelete: Cascade)
  imageUrl        String       @db.VarChar(500)
  imageStorageKey String?      @db.VarChar(255)
  imageAlt        String       @db.VarChar(255)
  caption         String?      @db.Text
  displayOrder    Int          @default(0)
  isPublished     Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([albumId, displayOrder])
  @@index([isPublished, displayOrder])
  @@map("gallery_images")
}

// ==========================================
// 13. ACADEMIC & SCHOOL EVENTS
// ==========================================

model SchoolEvent {
  id                   String    @id @default(cuid())
  title                String    @db.VarChar(150)
  description          String    @db.Text
  eventDate            String    @db.VarChar(100)
  isoDate              DateTime?
  time                 String?   @db.VarChar(100)
  location             String?   @db.VarChar(200)
  category             String?   @db.VarChar(60)
  linkHref             String?   @db.VarChar(500)
  linkLabel            String?   @db.VarChar(100)
  coverImageUrl        String?   @db.VarChar(500)
  coverImageStorageKey String?   @db.VarChar(255)
  coverImageAlt        String?   @db.VarChar(255)
  displayOrder         Int       @default(0)
  isPublished          Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([isPublished, displayOrder])
  @@index([isoDate])
  @@map("school_events")
}

// ==========================================
// 14. DOWNLOADS & PUBLIC RECORDS
// ==========================================

model DownloadCategory {
  id           String             @id @default(cuid())
  slug         String             @unique @db.VarChar(100)
  title        String             @db.VarChar(150)
  description  String?            @db.VarChar(500)
  displayOrder Int                @default(0)
  isPublished  Boolean            @default(true)
  documents    DownloadDocument[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([isPublished, displayOrder])
  @@map("download_categories")
}

model DownloadDocument {
  id             String           @id @default(cuid())
  categoryId     String
  category       DownloadCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  title          String           @db.VarChar(200)
  description    String?          @db.VarChar(500)
  fileUrl        String?          @db.VarChar(500)
  fileStorageKey String?          @db.VarChar(255)
  fileSizeBytes  Int?
  fileSize       String?          @db.VarChar(50)
  fileType       String           @default("application/pdf") @db.VarChar(100)
  displayOrder   Int              @default(0)
  isPublished    Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([categoryId, displayOrder])
  @@index([categoryId, isPublished])
  @@index([fileStorageKey])
  @@map("download_documents")
}

// ==========================================
// 15. MANDATORY PUBLIC DISCLOSURE (APPENDIX IX)
// ==========================================

model DisclosureSection {
  id           String               @id @default(cuid())
  slug         String               @unique @db.VarChar(100)
  title        String               @db.VarChar(150)
  description  String?              @db.VarChar(500)
  displayOrder Int                  @default(0)
  isPublished  Boolean              @default(true)
  documents    DisclosureDocument[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([isPublished, displayOrder])
  @@map("disclosure_sections")
}

model DisclosureDocument {
  id             String            @id @default(cuid())
  sectionId      String
  section        DisclosureSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  title          String            @db.VarChar(200)
  description    String?           @db.VarChar(500)
  fileUrl        String?           @db.VarChar(500)
  fileStorageKey String?           @db.VarChar(255)
  fileSizeBytes  Int?
  fileSize       String?           @db.VarChar(50)
  fileType       String            @default("application/pdf") @db.VarChar(100)
  linkLabel      String?           @default("VIEW/DOWNLOAD") @db.VarChar(100)
  displayOrder   Int               @default(0)
  isPublished    Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([sectionId, displayOrder])
  @@index([sectionId, isPublished])
  @@index([fileStorageKey])
  @@map("disclosure_documents")
}

// ==========================================
// 16. FACILITIES & CAMPUS INFRASTRUCTURE
// ==========================================

model FacilityCategory {
  id           String         @id @default(cuid())
  slug         String         @unique @db.VarChar(100)
  title        String         @db.VarChar(150)
  description  String?        @db.VarChar(500)
  displayOrder Int            @default(0)
  isPublished  Boolean        @default(true)
  items        FacilityItem[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([isPublished, displayOrder])
  @@map("facility_categories")
}

model FacilityItem {
  id              String           @id @default(cuid())
  categoryId      String
  category        FacilityCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  title           String           @db.VarChar(200)
  slug            String           @unique @db.VarChar(100)
  description     String           @db.Text
  imageUrl        String?          @db.VarChar(500)
  imageStorageKey String?          @db.VarChar(255)
  imageAlt        String           @default("Campus facility photograph") @db.VarChar(255)
  iconName        String?          @default("BookOpen") @db.VarChar(50)
  highlights      String[]         @default([])
  displayOrder    Int              @default(0)
  isPublished     Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([categoryId, displayOrder])
  @@index([categoryId, isPublished])
  @@index([isPublished, displayOrder])
  @@index([imageStorageKey])
  @@map("facility_items")
}

// ==========================================
// 17. ADMISSIONS & ENQUIRIES
// ==========================================

enum EnquiryStatus {
  PENDING
  CONTACTED
  RESOLVED
  ARCHIVED
}

model AdmissionStep {
