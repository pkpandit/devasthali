// Prisma Schema for Devasthaly Vidyapeeth — Administration & Identity
// Target: PostgreSQL
// Phase 1: Authentication & Audit Foundation
// Reference for full content & operational models: ./recovered-schema.prisma

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. ENUMS (ADMINISTRATIVE ROLES)
// ==========================================

enum Role {
  SUPER_ADMIN        // Trust management, full system access
  PRINCIPAL          // Academic director, approval authority, notices
  ADMISSIONS_OFFICER // Admissions desk, lead status tracking, fee verification
  TEACHER            // Class notices, homework, exam marks entry
  STAFF              // Office clerk, document/TC issuance
}

// ==========================================
// 2. CORE IDENTITY & AUTHENTICATION MODELS
// ==========================================

model User {
  id              String     @id @default(cuid())
  name            String
  email           String     @unique
  emailVerified   DateTime?
  passwordHash    String
  image           String?
  role            Role       @default(STAFF)
  isActive        Boolean    @default(true)
  phoneNumber     String?
  lastLoginAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  sessions        Session[]
  auditLogs       AuditLog[]
  noticesAuthored Notice[]   @relation("NoticesAuthored")

  @@index([role, isActive])
  @@map("users")
}

model Session {
  id               String   @id @default(cuid())
  sessionTokenHash String   @unique
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  ipAddress        String?
  userAgent        String?

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ==========================================
// 3. AUDIT TRAILS (AUTH & SECURITY EVENTS)
// ==========================================

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String   // E.g., 'AUTH_LOGIN_SUCCESS', 'AUTH_LOGIN_FAILED', 'AUTH_LOGOUT', 'AUTH_PASSWORD_CHANGE', 'AUTH_STATUS_CHANGE', 'NOTICE_CREATED', 'NOTICE_UPDATED', 'NOTICE_DELETED', 'NOTICE_STATUS_CHANGED', 'DOCUMENT_UPLOADED', 'DOCUMENT_REMOVED'
  entityType String   // Target entity type: 'User', 'Session', 'BoardResultTopper', 'Notice'
  entityId   String   // Target entity ID
  metadata   Json?    // Structured diagnostic context (IP, user agent, failure reason, modified fields)
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ==========================================
// 4. ACADEMIC RESULTS & TOPPERS
// ==========================================

model BoardResultTopper {
  id              String   @id @default(cuid())
  studentName     String
  scorePercent    Decimal  @db.Decimal(5, 2)
  grade           String   // "Class X" | "Class XII"
  stream          String?  // Optional: "Science (PCM)", "Commerce", "Humanities"
  academicYear    String   // e.g. "2024-25"
  achievement     String   // e.g. "School Topper - 98.4%"
  photoUrl        String?
  photoStorageKey String?
  displayOrder    Int      @default(0)
  isFeatured      Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([academicYear, grade])
  @@index([isFeatured, displayOrder])
  @@map("board_result_toppers")
}

// ==========================================
// 5. OFFICIAL NOTICES & CIRCULARS
// ==========================================

enum NoticeCategory {
  CIRCULAR             // Administrative, holiday, and operational circulars
  EXAMINATION          // Date sheets, entrance tests, hall tickets, results
  ADMISSION            // Admission announcements and prospectus notices
  EVENT                // School ceremonies, exhibitions, competitions
}

model Notice {
  id               String         @id @default(cuid())
  title            String
  slug             String         @unique
  category         NoticeCategory @default(CIRCULAR)
  summary          String?        @db.Text
  content          String?        @db.Text
  isUrgent         Boolean        @default(false)
  isPublished      Boolean        @default(false)
  fileUrl          String?        // Approved root-relative document path or HTTPS URL
  fileSize         String?        // Human-readable size indicator (e.g. "245 KB")
  publishDate      DateTime       @default(now())
  publishedAt      DateTime?      // Exact timestamp when marked published
  expiryDate       DateTime?      // Optional date after which notice is archived
  displayOrder     Int            @default(0)

  // Managed document attachment metadata (Phase 2)
  fileStorageKey   String?        @db.VarChar(255)
  fileSizeBytes    Int?
  fileSha256       String?        @db.VarChar(64)
  fileOriginalName String?        @db.VarChar(255)
  fileUploadedAt   DateTime?

  authorId         String?
  author           User?          @relation("NoticesAuthored", fields: [authorId], references: [id], onDelete: SetNull)

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([isPublished, publishDate])
  @@index([category, isPublished])
  @@index([displayOrder, publishDate])
  @@index([fileStorageKey])
  @@map("notices")
}
